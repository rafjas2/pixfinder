# Pixabay API Configuration
# Get your key at: https://pixabay.com/api/docs/

# Local Development (Exposed to Vite/Client)
VITE_PIXABAY_API_KEY=your_public_key_here
VITE_PIXABAY_API_URL=https://pixabay.com/api

# Production (Vercel Serverless/Edge)
# Add these strictly in your Vercel Dashboard Environment Variables!
PIXABAY_API_KEY=your_private_key_here
PIXABAY_API_URL=https://pixabay.com/api
